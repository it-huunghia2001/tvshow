generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model settings {
  id            Int     @id @default(autoincrement())
  branch_id     String  @unique
  customer_name String  @default("SẴN SÀNG TRAO XE")
  image_url     String?
  // Tùy chỉnh giao diện
  theme_id      String  @default("luxury-dark")
  font_size     Int     @default(15) // Tính theo đơn vị vh
  text_color    String  @default("#F5C842")
  accent_color  String  @default("#FFFFFF")

  updated_at DateTime @default(now()) @updatedAt
}
